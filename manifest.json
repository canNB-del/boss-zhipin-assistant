{
  "manifest_version": 3,
  "name": "Boss 直聘应聘助手",
  "version": "0.7.3",
  "description": "读取BOSS聊天中的HR问题，生成候选回复并填充输入框；发送由用户手动确认。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*"
  ],
  "action": {
    "default_title": "打开 Boss 直聘应聘助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
