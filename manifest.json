{
  "manifest_version": 3,
  "name": "Boss 直聘应聘助手",
  "version": "0.6.0",
  "description": "读取BOSS聊天中的HR问题，生成候选回复并填充输入框；发送由用户手动确认。",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.zhipin.com/*", "https://api.openai.com/*"],
  "action": {
    "default_title": "Boss 直聘应聘助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
